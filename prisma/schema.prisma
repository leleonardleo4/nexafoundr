generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  FOUNDER
  INVESTOR
  ADMIN
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum InvestmentStatus {
  PENDING
  PENDING_DEPOSIT
  FUNDED
  RELEASED
}

enum MilestoneStatus {
  PENDING
  APPROVED
  RELEASED
}

enum ConversationStatus {
  PENDING
  ACTIVE
  CLOSED
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  role          UserRole
  profileImage  String?
  image         String?
  founderWalletAddress String?
  emailVerified Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  startups      Startup[]   @relation("FounderStartups")
  investments   Investment[] @relation("InvestorInvestments")
  savedStartups SavedStartup[] @relation("InvestorSavedStartups")
  founderConversations Conversation[] @relation("FounderConversations")
  investorConversations Conversation[] @relation("InvestorConversations")
  founderWalletBalances FounderWalletBalance[]
  messages      Message[]  @relation("SentMessages")
  accounts      Account[]
  sessions      Session[]
}

model Startup {
  id                 String             @id @default(cuid())
  founderId          String
  name               String
  description        String
  industry           String
  stage              String
  fundingRequired    Float
  equityOffered      Float
  teamInformation    Json?
  websiteUrl         String?
  verificationStatus VerificationStatus @default(PENDING)

  founder            User              @relation("FounderStartups", fields: [founderId], references: [id], onDelete: Cascade)
  investments        Investment[]
  documents          StartupDocuments?
  savedBy            SavedStartup[]
  conversations      Conversation[]
}

model StartupDocuments {
  id                 String   @id @default(cuid())
  startupId          String   @unique
  pitchDeckUrl       String?
  cacRegistrationUrl String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  startup            Startup  @relation(fields: [startupId], references: [id], onDelete: Cascade)
}

model Investment {
  id                       String           @id @default(cuid())
  startupId                String
  investorId               String
  amount                   Float
  status                   InvestmentStatus @default(PENDING)
  escrowAddress            String?
  investorWalletAddress    String?
  founderWalletAddress     String?
  milestoneAuthorityAddress String?

  startup                  Startup          @relation(fields: [startupId], references: [id], onDelete: Cascade)
  investor                 User             @relation("InvestorInvestments", fields: [investorId], references: [id], onDelete: Cascade)
  milestones               Milestone[]
}

model FounderWalletBalance {
  id                String   @id @default(cuid())
  founderId         String   @unique
  creditedLamports   BigInt   @default(0)
  updatedAt         DateTime @updatedAt
  createdAt         DateTime @default(now())

  founder           User     @relation(fields: [founderId], references: [id], onDelete: Cascade)

  @@index([founderId])
}

model Milestone {
  id           String          @id @default(cuid())
  investmentId String
  title        String
  description  String?
  amountLamports String
  status       MilestoneStatus @default(PENDING)
  dueDate      DateTime?
  approvedAt   DateTime?
  releasedAt   DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  investment   Investment      @relation(fields: [investmentId], references: [id], onDelete: Cascade)

  @@index([investmentId])
}

model SavedStartup {
  id         String   @id @default(cuid())
  investorId String
  startupId  String
  createdAt  DateTime @default(now())

  investor   User     @relation("InvestorSavedStartups", fields: [investorId], references: [id], onDelete: Cascade)
  startup    Startup  @relation(fields: [startupId], references: [id], onDelete: Cascade)

  @@unique([investorId, startupId])
  @@index([investorId])
  @@index([startupId])
}

model Conversation {
  id         String   @id @default(cuid())
  founderId  String
  investorId String
  startupId  String?
  status     ConversationStatus @default(PENDING)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  founder    User      @relation("FounderConversations", fields: [founderId], references: [id], onDelete: Cascade)
  investor   User      @relation("InvestorConversations", fields: [investorId], references: [id], onDelete: Cascade)
  startup    Startup?  @relation(fields: [startupId], references: [id], onDelete: SetNull)
  messages   Message[]

  @@unique([founderId, investorId])
  @@index([founderId])
  @@index([investorId])
  @@index([startupId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
}

model Account {
  id                     String   @id
  providerId             String
  accountId              String
  userId                 String
  accessToken            String?
  refreshToken           String?
  idToken                String?
  accessTokenExpiresAt   DateTime?
  refreshTokenExpiresAt  DateTime?
  scope                  String?
  password               String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Session {
  id         String   @id
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  userId     String
  expiresAt  DateTime
  token      String   @unique
  ipAddress  String?
  userAgent  String?

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  value      String
  expiresAt  DateTime
  identifier String

  @@index([identifier])
}
